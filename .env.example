# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================

# Recommended for most uses (with pgbouncer connection pooling)
DATABASE_URL=postgresql://your_user:your_password@your-host.region.aws.neon.tech/your_database?sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://your_user:your_password@your-host.region.aws.neon.tech/your_database?sslmode=require

# Parameters for constructing your own connection string
PGHOST=your-host-pooler.region.aws.neon.tech
PGHOST_UNPOOLED=your-host.region.aws.neon.tech
PGUSER=your_database_user
PGDATABASE=your_database_name
PGPASSWORD=your_database_password

# ============================================
# Vercel Postgres Templates Parameters
# ============================================

POSTGRES_URL=postgresql://your_user:your_password@your-host.region.aws.neon.tech/your_database?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://your_user:your_password@your-host.region.aws.neon.tech/your_database?sslmode=require
POSTGRES_USER=your_database_user
POSTGRES_HOST=your-host-pooler.region.aws.neon.tech
POSTGRES_PASSWORD=your_database_password
POSTGRES_DATABASE=your_database_name
POSTGRES_URL_NO_SSL=postgresql://your_user:your_password@your-host.region.aws.neon.tech/your_database
POSTGRES_PRISMA_URL=postgresql://your_user:your_password@your-host.region.aws.neon.tech/your_database?connect_timeout=15&sslmode=require

# ============================================
# Neon Auth Environment Variables (Next.js)
# ============================================

NEXT_PUBLIC_STACK_PROJECT_ID=your-stack-project-id-here
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=pck_your_publishable_client_key_here
STACK_SECRET_SERVER_KEY=ssk_your_secret_server_key_here

# ============================================
# Better Auth Configuration
# ============================================

# Secret key for session encryption (generate a random 32+ character string)
# Example: use `openssl rand -base64 32` to generate
BETTER_AUTH_SECRET=your-randomly-generated-secret-key-min-32-chars

# Auth service URL (use your deployed backend URL or localhost for development)
# Production examples:
#   - https://your-backend.vercel.app/api/auth
#   - https://your-backend.onrender.com/api/auth
# Development: http://localhost:4000/api/auth
BETTER_AUTH_URL=http://localhost:4000/api/auth

# ============================================
# Frontend Configuration
# ============================================

# Frontend application URL for CORS and authentication
# Production: https://your-frontend-app.vercel.app
# Development: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ============================================
# Server Configuration (Optional)
# ============================================

# Server port (defaults to 4000 if not set)
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development
