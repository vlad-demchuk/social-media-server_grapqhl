# Docker Compose Environment Variables
# Copy this to .env.docker.local and customize for your local Docker setup

# Database (connects to the 'db' service in docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@db:5432/social_media?sslmode=disable

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Better Auth Configuration
BETTER_AUTH_SECRET=your-randomly-generated-secret-key-min-32-chars-for-docker
BETTER_AUTH_URL=http://localhost:4000/api/auth

# Optional: Stack Project (if using)
# NEXT_PUBLIC_STACK_PROJECT_ID=your-stack-project-id
